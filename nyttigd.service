[Unit]
Description=Nyttig news aggregator daemon
Documentation=https://github.com/sonhal/nyttig
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/bin/nyttigd --socket /tmp/nyttig.sock --config %h/.config/nyttig/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
Environment="PATH=%h/bin:/usr/local/bin:/usr/bin:/bin"

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/nyttig
ReadWritePaths=/tmp/nyttig.sock
ReadOnlyPaths=%h/.config/nyttig

[Install]
WantedBy=default.target