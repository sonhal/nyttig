# Copy to .env next to compose.yaml.

# The URL the browser uses, with no path. nyttig-api checks the Host and
# Origin headers against it, and the web app builds its URLs from it.
NYTTIG_ORIGIN=https://nyttig.example.com

# Image tag to run: a release without the "v" (0.5.0), a minor series (0.5),
# or latest. Pin a version in production and upgrade on purpose.
NYTTIG_VERSION=latest

# Optional: the Clef assessor (compose.clef.yaml, see README.md). To use it
# together with mutual TLS, list both overlays:
# COMPOSE_FILE=compose.yaml:compose.clef.yaml
# COMPOSE_FILE=compose.yaml:compose.mtls.yaml:compose.clef.yaml

# Optional: the TUI over mutual TLS (compose.mtls.yaml, see README.md).
# COMPOSE_FILE=compose.yaml:compose.mtls.yaml
# NYTTIG_TLS_PUBLISH=[2001:db8::10]:9090
