# Copy to .env next to compose.yaml.

# The URL the browser uses, with no path. nyttig-api checks the Host and
# Origin headers against it, and the web app builds its URLs from it.
NYTTIG_ORIGIN=https://nyttig.example.com

# Image tag to run: a release without the "v" (0.5.0), a minor series (0.5),
# or latest. Pin a version in production and upgrade on purpose.
NYTTIG_VERSION=latest
