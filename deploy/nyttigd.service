# nyttigd on a dedicated server, exposed over TCP with mutual TLS.
# Install to /etc/systemd/system/nyttigd.service (see deploy/README.md).
#
# LoadCredential= lets the TLS files stay root-only on disk: systemd copies them
# into /run/credentials/nyttigd.service/, readable only by this service.

[Unit]
Description=Nyttig news aggregator daemon
Documentation=https://github.com/sonhal/nyttig/tree/main/deploy
After=network-online.target
Wants=network-online.target

[Service]
User=nyttig
Group=nyttig
ExecStart=/usr/local/bin/nyttigd --config /etc/nyttigd/config.toml
# No ExecReload: nyttigd exits on SIGHUP. Use `systemctl restart nyttigd`.
Restart=on-failure
RestartSec=5
Environment=HOME=/var/lib/nyttigd

LoadCredential=server.pem:/etc/nyttigd/tls/server.pem
LoadCredential=server.key:/etc/nyttigd/tls/server.key
LoadCredential=ca.pem:/etc/nyttigd/tls/ca.pem

# /var/lib/nyttigd holds the SQLite database.
StateDirectory=nyttigd
StateDirectoryMode=0700
UMask=0077

# Sandboxing; check with `systemd-analyze security nyttigd`.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Feeds are fetched from here; keep them off the cloud metadata service (SSRF).
IPAddressDeny=169.254.169.254
MemoryMax=512M

[Install]
WantedBy=multi-user.target
