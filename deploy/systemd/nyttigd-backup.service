# Daily online backup of the nyttigd database, run by nyttigd-backup.timer.
# SQLite's .backup is consistent while nyttigd writes; never `cp` a live WAL
# database. Copies land in /var/lib/nyttig/backups and are kept for 14 days.

[Unit]
Description=Back up the nyttigd database
After=nyttigd.service

[Service]
Type=oneshot
User=nyttig
Group=nyttig
StateDirectory=nyttig nyttig/backups
StateDirectoryMode=0700
UMask=0077
ExecStart=/bin/sh -c 'sqlite3 /var/lib/nyttig/nyttig.db ".timeout 30000" ".backup /var/lib/nyttig/backups/nyttig-$$(date +%%F).db" && find /var/lib/nyttig/backups -name "nyttig-*.db" -mtime +14 -delete'
